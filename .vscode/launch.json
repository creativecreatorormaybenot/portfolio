{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: dev (hot reload)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(http://[^\\s]+)"
      },
      "presentation": {
        "hidden": false,
        "group": "vite"
      }
    }
  ]
}
